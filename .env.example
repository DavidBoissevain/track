# Copy this file to .env.local and fill in the key.
# Supabase dashboard: Project Settings -> API keys

# The project root URL. Not the REST endpoint: leave off the /rest/v1/ part,
# the client appends /rest/v1 and /auth/v1 itself.
NEXT_PUBLIC_SUPABASE_URL=https://kkcwrvcdfbvczbqjxiss.supabase.co

# Use the publishable key, the one that starts with sb_publishable_.
# Not the legacy anon key. This one is meant to be public: it reaches only
# what row level security allows, which is why NEXT_PUBLIC_ is correct here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not needed yet, and there is nothing in the app that uses it. Only add a
# secret key (sb_secret_...) when something on the server genuinely has to
# bypass row level security. Never give it the NEXT_PUBLIC_ prefix, that
# would ship it to the browser.
# SUPABASE_SECRET_KEY=
